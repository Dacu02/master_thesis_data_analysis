@startuml stroke_network_training
title Stroke network - training

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "Data pipeline" as D
participant "Network" as N #E6E0FA
participant "Loss" as L
participant "Trainer" as T

== Data preparation ==
D -> D : Isolate each stroke
D -> D : Pair strokes with previous stroke\nand next waypoint
D -> D : Train and validation split
D -> D : Standardization

== Initialization ==
D -> N : Initialize MDN head\nwith precomputed\nmeans and covariances

== Training ==
loop each epoch
  loop each mini-batch
    D -> D : Random rotation / reflection
    D -> D : Gaussian noise
    D -> N : Waypoints, first-stroke flag,\ntrue previous stroke
    D -> L : True stroke parameters
    N -> L : Predicted mixture\n(weights, means, covariances)
    L -> L : Mixture negative log-likelihood\nof the true stroke
    L --> N : Backpropagate error
    N -> T : Gradients
    T -> N : Clip gradients, update weights
  end

  == Validation ==
  D -> N : Held-out strokes\n(clean inputs, no weight update)
  D -> L : True stroke parameters
  N -> L : Predicted mixture
  L --> T : Validation NLL
  T -> T : Save checkpoint if best,\nstop after PATIENCE epochs\nwithout best
end

== Model selection ==
T -> N : Restore best weights
@enduml