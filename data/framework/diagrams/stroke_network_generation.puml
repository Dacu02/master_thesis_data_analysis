@startuml stroke_network_generation

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "User" as U
participant "Generator" as G
participant "Network" as N #E6E0FA
participant "Builder" as B

U -> G : Waypoints + random seed

loop for each stroke (target = next waypoint)
  G -> G : Express waypoints relative to\nthe current end point
  G -> N : Conditioning + previous generated stroke\n(start-of-sequence input for the first)
  N -> N : Pick a mixture component,\nsample a Gaussian
  N --> G : Sampled stroke parameters
  G -> G : Enforce valid ranges,\nadvance end point
end

G -> B : Stroke sequence
B -> B : Amplitude of each stroke = Bézier arc length
B -> B : Sum lognormal speed profiles over time
B -> B : Speed minima between peaks = segment boundaries
B -> B : Cumulative normalized speed = arc-length fraction\npoint along the Bézier segment
B --> U : Trajectory + speed profile
@enduml